generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  SUPERADMIN
  ADMIN
  STAFF
}

enum ModuleName {
  DASHBOARD
  CUSTOMERS
  PRICE_LISTS
  ORDERS
  SALES
  QUOTATIONS
  PAYMENTS
  CUSTOMER_LEDGER
  RECEIVABLES
  SUPPLIERS
  PURCHASE_ORDERS
  GOODS_RECEIPTS
  SUPPLIER_BILLS
  PURCHASE_RETURNS
  SUPPLIER_PAYMENTS
  SUPPLIER_LEDGER
  ACCOUNTS_PAYABLE
  EXPENSES
  INVENTORY
  INVENTORY_OUTWARD
  STOCK_TRANSFERS
  FOLLOWUPS_TASKS
  REPORTS
  DOCUMENTS
  USER_PERMISSIONS
  COMPANY_CONFIG
}

enum ActionName {
  VIEW
  CREATE
  EDIT
  DELETE
  APPROVE
  REJECT
  ASSIGN
  REOPEN
  CHANGE_PRICE
  APPLY_DISCOUNT
  APPROVE_EXCEPTION
  CREATE_SALE
  CONVERT_ORDER_TO_SALE
  MANAGE_CUSTOMERS
  RECORD_PAYMENT
  VERIFY_PAYMENT
  EDIT_PAYMENT
  ALLOCATE_PAYMENT
  REVERSE_PAYMENT
  MANAGE_INVENTORY
  CREATE_OUTWARD
  TRANSFER_STOCK
  APPROVE_DISCREPANCY
  MANAGE_LOCATIONS
  VIEW_REPORTS
  VIEW_PROFIT_MARGINS
  DOWNLOAD_DOCUMENTS
  EXPORT_DATA
  CLOSE
  CONVERT_TO_SALE
  POST
  ALLOCATE
  AUTO_ALLOCATE_OLDEST_FIRST
  ACCEPT_CUSTOMER_ADVANCE
  APPLY_ADVANCE
  REVERSE
  PRINT
  SUBMIT
  CANCEL
  DEACTIVATE
}

enum DataScope {
  OWN
  ASSIGNED
  ALL
}

enum PermissionChangeType {
  GRANT
  MODIFY
  REVOKE
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
  CORPORATE
  CUSTOM
}

enum StockMovementType {
  INWARD
  OUTWARD
  TRANSFER_OUT
  TRANSFER_IN
  RETURN
  ADJUSTMENT
}

enum TransferStatus {
  DISPATCHED
  COMPLETED
  DISCREPANCY_REPORTED
}

// Order & Sales statuses marked as pending confirmation
enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SalePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum SaleApprovalStatus {
  AUTO_APPROVED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum OutwardReconciliationStatus {
  PENDING
  RECONCILED
  DISCREPANCY
}

enum OutwardStatus {
  DRAFT
  DISPATCHED
  RECONCILED
  DISCREPANCY_PENDING
  DISCREPANCY_APPROVED
  CLOSED
  REOPENED
}

enum OutwardDisposition {
  SOLD
  TRANSFERRED
  RETURNED_TO_STOCK
  CONSUMED
  DAMAGED
  OTHER
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CREDIT_UDHAAR
  OTHER
}

enum PaymentStatus {
  DRAFT
  POSTED
  PARTIALLY_REVERSED
  REVERSED
}

enum AllocationType {
  MANUAL
  OLDEST_FIRST
  ADVANCE_APPLIED
}

enum AdvanceMovementType {
  PAYMENT_UNALLOCATED
  PAYMENT_ALLOCATED
  ADVANCE_APPLIED
  PAYMENT_REFUNDED
  PAYMENT_REVERSED
  ALLOCATION_REVERSED
  AUTHORIZED_ADJUSTMENT
}

enum PaymentVerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  REVERSED
}

enum LedgerEntryType {
  SALE_INVOICE
  PAYMENT_RECEIPT
  ADVANCE_APPLIED
  PAYMENT_REVERSAL
  ALLOCATION_REVERSAL
  CREDIT_NOTE
  DEBIT_NOTE
  REVERSAL
  OPENING_BALANCE
  AUTHORIZED_ADJUSTMENT
}

enum FollowUpType {
  CALL
  WHATSAPP
  MEETING
  NOTE
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  SNOOZED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
  REVERSED
}

enum SupplierBillStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PurchaseReturnStatus {
  DRAFT
  APPROVED
  POSTED
  CANCELLED
}

enum SupplierPaymentStatus {
  POSTED
  REVERSED
}

enum SupplierLedgerEntryType {
  PURCHASE_BILL
  SUPPLIER_PAYMENT
  PAYMENT_REVERSAL
  PURCHASE_RETURN
  SUPPLIER_CREDIT_NOTE
  OPENING_BALANCE
  AUTHORIZED_ADJUSTMENT
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  REJECTED
  REVERSED
}

// -------------------------------------------------------------
// CORE USER & PERMISSIONS (GLOBAL PERMISSION ARCHITECTURE)
// -------------------------------------------------------------

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String
  phone        String?
  role         Role         @default(STAFF)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  permissions         Permission[]
  auditLogs           AuditLog[]
  grantedPermissions  Permission[] @relation("GrantedBy")
  permissionAuditsTarget PermissionAuditLog[] @relation("TargetUser")
  permissionAuditsAuthor PermissionAuditLog[] @relation("ChangedByUser")

  createdCustomers    Customer[]   @relation("CustomerCreator")
  assignedCustomers   Customer[]   @relation("CustomerAssignee")

  createdOrders       Order[]      @relation("OrderCreator")
  assignedOrders      Order[]      @relation("OrderAssignee")
  createdSales        Sale[]       @relation("SaleCreator")
  finalizedSales      Sale[]       @relation("SaleFinalizer")
  createdQuotations   Quotation[]  @relation("QuotationCreator")
  createdOutwards     InventoryOutward[] @relation("OutwardResponsibleStaff")
  dispatchedOutwards  InventoryOutward[] @relation("OutwardDispatcher")
  closedOutwards      InventoryOutward[] @relation("OutwardCloser")
  reopenedOutwards    InventoryOutward[] @relation("OutwardReopener")
  outwardApprovalsGiven OutwardApproval[] @relation("OutwardApprover")
  outwardApprovalsRequested OutwardApproval[] @relation("OutwardRequester")
  assignedFollowUps   FollowUp[]   @relation("FollowUpAssignee")
  createdFollowUps    FollowUp[]   @relation("FollowUpCreator")
  createdPayments     Payment[]    @relation("PaymentCreator")
  verifiedPayments    Payment[]    @relation("PaymentVerifier")
  reversedPayments    Payment[]    @relation("PaymentReverser")
  createdSuppliers    Supplier[]   @relation("SupplierCreator")
  createdPOs          PurchaseOrder[] @relation("POCreator")
  approvedPOs         PurchaseOrder[] @relation("POApprover")
  createdGRNs         GoodsReceipt[] @relation("GRNCreator")
  postedGRNs          GoodsReceipt[] @relation("GRNPoster")
  createdBills        SupplierBill[] @relation("BillCreator")
  postedBills         SupplierBill[] @relation("BillPoster")
  createdReturns      PurchaseReturn[] @relation("ReturnCreator")
  postedReturns       PurchaseReturn[] @relation("ReturnPoster")
  createdSupplierPayments SupplierPayment[] @relation("SupplierPaymentCreator")
  reversedSupplierPayments SupplierPayment[] @relation("SupplierPaymentReverser")
  createdExpenses     Expense[]    @relation("ExpenseCreator")
  approvedExpenses    Expense[]    @relation("ExpenseApprover")

  @@index([email])
  @@index([role])
}

model Permission {
  id        String     @id @default(uuid())
  userId    String
  module    ModuleName
  action    ActionName
  scope     DataScope  @default(OWN)
  grantedById String
  grantedAt DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User       @relation("GrantedBy", fields: [grantedById], references: [id])

  @@unique([userId, module, action])
  @@index([userId])
}

model PermissionAuditLog {
  id            String               @id @default(uuid())
  targetUserId  String
  changedById   String
  module        ModuleName
  action        ActionName
  previousScope DataScope?
  newScope      DataScope?
  changeType    PermissionChangeType
  reason        String
  createdAt     DateTime             @default(now())

  targetUser    User                 @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  changedByUser User                 @relation("ChangedByUser", fields: [changedById], references: [id])

  @@index([targetUserId])
  @@index([changedById])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  entityType   String
  entityId     String?
  previousState Json?
  newState     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// -------------------------------------------------------------
// CUSTOMERS & PRICING
// -------------------------------------------------------------

model Customer {
  id              String             @id @default(uuid())
  customerCode    String             @unique
  name            String             // Business or Customer Name
  contactPerson   String?            // Primary Contact Person
  phone           String             // Non-unique: allows legitimate shared business contacts
  email           String?            // Optional email
  billingAddress  String?
  shippingAddress String?
  deliveryAddress String?            // Alias / legacy compatibility
  customerType    CustomerType       @default(RETAIL)
  gstin           String?            // Optional GSTIN format validated in app
  notes           String?
  priceListId     String?
  assignedToId    String?            // Data scope: ASSIGNED
  createdById     String?            // Data scope: OWN
  advanceBalance  Decimal            @default(0)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  priceList       CustomerPriceList? @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  assignedTo      User?              @relation("CustomerAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy       User?              @relation("CustomerCreator", fields: [createdById], references: [id], onDelete: SetNull)

  orders          Order[]
  sales           Sale[]
  quotations      Quotation[]
  payments        Payment[]
  ledgerEntries   CustomerLedger[]
  advanceMovements CustomerAdvanceMovement[]
  paymentAllocations PaymentAllocation[]
  followUps       FollowUp[]

  @@index([phone])
  @@index([name])
  @@index([assignedToId])
  @@index([createdById])
}

model CustomerPriceList {
  id                 String          @id @default(uuid())
  name               String          @unique
  type               CustomerType    @default(RETAIL)
  description        String?
  discountPercentage Decimal         @default(0)
  isDefault          Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  customers          Customer[]
  productPrices      ProductPrice[]
}

// -------------------------------------------------------------
// PRODUCTS & MULTI-LOCATION INVENTORY
// -------------------------------------------------------------

model Product {
  id            String          @id @default(uuid())
  sku           String          @unique
  barcode       String?         @unique
  name          String
  description   String?
  unit          String          @default("pcs")
  category      String
  basePrice     Decimal
  costPrice     Decimal?        // Guarded: visible only with VIEW_PROFIT_MARGINS
  taxRate       Decimal         @default(18.0)
  minStockAlert Int             @default(10)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  prices        ProductPrice[]
  stockBalances StockBalance[]
  stockMovements StockMovement[]
  stockTransfers StockTransfer[]
  orderItems    OrderItem[]
  saleItems     SaleItem[]
  quotationItems QuotationItem[]
  outwardEntries InventoryOutward[]
  outwardLines   InventoryOutwardLine[]
  outwardReconciliations OutwardReconciliation[]
  poItems        PurchaseOrderItem[]
  grnLines       GoodsReceiptLine[]
  billItems      SupplierBillItem[]
  returnLines    PurchaseReturnLine[]

  @@index([sku])
  @@index([category])
  @@index([barcode])
}

model ProductPrice {
  id          String            @id @default(uuid())
  priceListId String
  productId   String
  customPrice Decimal

  priceList   CustomerPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
}

model Location {
  id         String         @id @default(uuid())
  name       String         @unique
  code       String         @unique
  address    String?
  isDefault  Boolean        @default(false)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  stockBalances    StockBalance[]
  stockMovements   StockMovement[]
  outwardEntries   InventoryOutward[]
  returnReconciliations OutwardReconciliation[]
  sourceTransfers  StockTransfer[] @relation("SourceLocation")
  destTransfers    StockTransfer[] @relation("DestLocation")
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  purchaseReturns  PurchaseReturn[]
  expenses         Expense[]
}

model StockBalance {
  id         String   @id @default(uuid())
  locationId String
  productId  String
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt

  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([locationId, productId])
}

model StockMovement {
  id            String            @id @default(uuid())
  movementType  StockMovementType
  productId     String
  locationId    String
  quantity      Int               // Positive for addition, negative for deduction
  balanceAfter  Int               // Must never be negative
  referenceType String
  referenceId   String?           // e.g. TRF-1001, INW-1001
  performedById String
  reason        String?
  createdAt     DateTime          @default(now())

  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  location      Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([productId, locationId])
  @@index([createdAt])
  @@index([referenceId])
}

model StockTransfer {
  id                    String         @id @default(uuid())
  transferNumber        String         @unique
  sourceLocationId      String
  destinationLocationId String
  productId             String
  quantity              Int
  status                TransferStatus @default(COMPLETED)
  senderId              String
  receiverId            String?
  notes                 String?
  createdAt             DateTime       @default(now())

  sourceLocation        Location       @relation("SourceLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation   Location       @relation("DestLocation", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  product               Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  linkedOutwards        InventoryOutward[]
  linkedReconciliations OutwardReconciliation[]

  @@index([transferNumber])
}

// -------------------------------------------------------------
// ORDERS & SEPARATE SALES (MANDATORY SEPARATION)
// -------------------------------------------------------------

model Order {
  id                   String      @id @default(uuid())
  orderNumber          String      @unique
  customerId           String
  customerName         String?
  orderDate            DateTime    @default(now())
  expectedDeliveryDate DateTime?
  deliveryAddress      String?
  subtotal             Decimal
  discount             Decimal     @default(0)
  tax                  Decimal     @default(0)
  deliveryCharges      Decimal     @default(0)
  grandTotal           Decimal
  status               OrderStatus @default(PENDING)
  createdById          String
  assignedToId         String?
  notes                String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  customer             Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy            User        @relation("OrderCreator", fields: [createdById], references: [id])
  assignedTo           User?       @relation("OrderAssignee", fields: [assignedToId], references: [id])
  items                OrderItem[]
  resultingSale        Sale?

  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  productName String?
  sku         String?
  unit        String?  @default("pcs")
  quantity    Int
  unitPrice   Decimal
  discount    Decimal  @default(0)
  taxRate     Decimal  @default(18.0)
  lineTotal   Decimal

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Sale {
  id              String             @id @default(uuid())
  saleNumber      String             @unique
  invoiceNumber   String?            @unique
  orderId         String?            @unique
  quotationId     String?            @unique
  customerId      String
  customerName    String?
  customerGstin   String?
  billingAddress  String?
  shippingAddress String?
  saleDate        DateTime           @default(now())
  dueDate         DateTime?
  subtotal        Decimal
  discount        Decimal            @default(0)
  tax             Decimal            @default(0)
  deliveryCharges Decimal            @default(0)
  grandTotal      Decimal
  paidAmount      Decimal            @default(0)
  balanceAmount   Decimal
  isFinalized     Boolean            @default(false)
  finalizedAt     DateTime?
  finalizedById   String?
  paymentStatus   SalePaymentStatus  @default(UNPAID)
  approvalStatus  SaleApprovalStatus @default(AUTO_APPROVED)
  approvedById    String?
  overrideReason  String?
  createdById     String
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  linkedOrder     Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  linkedQuotation Quotation?         @relation("QuotationResultingSale", fields: [quotationId], references: [id], onDelete: SetNull)
  createdBy       User               @relation("SaleCreator", fields: [createdById], references: [id])
  finalizedBy     User?              @relation("SaleFinalizer", fields: [finalizedById], references: [id])
  items           SaleItem[]
  allocations     PaymentAllocation[]
  advanceMovements CustomerAdvanceMovement[]
  linkedOutwards  InventoryOutward[]
  linkedReconciliations OutwardReconciliation[]

  @@index([saleNumber])
  @@index([invoiceNumber])
  @@index([customerId])
  @@index([isFinalized])
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  productId   String
  productName String?
  sku         String?
  unit        String?  @default("pcs")
  quantity    Int
  unitPrice   Decimal
  discount    Decimal  @default(0)
  taxRate     Decimal  @default(18.0)
  lineTotal   Decimal
  costPrice   Decimal?

  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String          @unique
  customerId      String
  customerName    String?
  quotationDate   DateTime        @default(now())
  validUntil      DateTime
  subtotal        Decimal
  discount        Decimal         @default(0)
  tax             Decimal         @default(0)
  deliveryCharges Decimal         @default(0)
  grandTotal      Decimal
  status          QuotationStatus @default(DRAFT)
  convertedSaleId String?         @unique
  createdById     String
  notes           String?
  issuedAt        DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  reopenedAt      DateTime?
  reopenedById    String?
  reopenReason    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy       User            @relation("QuotationCreator", fields: [createdById], references: [id])
  items           QuotationItem[]
  resultingSale   Sale?           @relation("QuotationResultingSale")

  @@index([quotationNumber])
  @@index([customerId])
  @@index([status])
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  productId   String
  productName String?
  sku         String?
  unit        String?   @default("pcs")
  quantity    Int
  unitPrice   Decimal
  discount    Decimal   @default(0)
  taxRate     Decimal   @default(18.0)
  lineTotal   Decimal

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
}

// -------------------------------------------------------------
// INVENTORY OUTWARD & RECONCILIATION
// -------------------------------------------------------------

model InventoryOutward {
  id                   String                      @id @default(uuid())
  outwardNumber        String                      @unique
  status               OutwardStatus               @default(DRAFT)
  sourceLocationId     String
  destinationLocationId String?
  purpose              String
  takenBy              String
  notes                String?
  destination          String?
  responsibleStaffId   String
  createdById          String?
  dispatchedAt         DateTime?
  dispatchedById       String?
  closedAt             DateTime?
  closedById           String?
  reopenedAt           DateTime?
  reopenedById         String?
  reopenReason         String?
  hasDiscrepancy       Boolean                     @default(false)
  discrepancyReason    String?
  approvedById         String?
  approvedAt           DateTime?
  approvalNotes        String?
  totalDispatchedQty   Int                         @default(0)
  totalReconciledQty   Int                         @default(0)
  totalDiscrepancyQty  Int                         @default(0)
  linkedSaleId         String?
  linkedTransferId     String?
  reconciliationStatus OutwardReconciliationStatus @default(PENDING)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  productId            String?
  quantity             Int?

  product              Product?                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceLocation       Location                    @relation(fields: [sourceLocationId], references: [id], onDelete: Restrict)
  responsibleStaff     User                        @relation("OutwardResponsibleStaff", fields: [responsibleStaffId], references: [id])
  dispatchedBy         User?                       @relation("OutwardDispatcher", fields: [dispatchedById], references: [id])
  closedBy             User?                       @relation("OutwardCloser", fields: [closedById], references: [id])
  reopenedBy           User?                       @relation("OutwardReopener", fields: [reopenedById], references: [id])
  linkedSale           Sale?                       @relation(fields: [linkedSaleId], references: [id], onDelete: SetNull)
  linkedTransfer       StockTransfer?              @relation(fields: [linkedTransferId], references: [id], onDelete: SetNull)

  lines                InventoryOutwardLine[]
  reconciliations      OutwardReconciliation[]
  approvals            OutwardApproval[]

  @@index([outwardNumber])
  @@index([status])
  @@index([sourceLocationId])
  @@index([responsibleStaffId])
  @@index([reconciliationStatus])
}

model InventoryOutwardLine {
  id              String   @id @default(uuid())
  outwardId       String
  productId       String
  quantity        Int
  unit            String   @default("pcs")
  reconciledQty   Int      @default(0)
  discrepancyQty  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  outward         InventoryOutward        @relation(fields: [outwardId], references: [id], onDelete: Cascade)
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  reconciliations OutwardReconciliation[]

  @@unique([outwardId, productId])
  @@index([outwardId])
  @@index([productId])
}

model OutwardReconciliation {
  id                    String              @id @default(uuid())
  outwardId             String
  lineId                String?
  productId             String
  disposition           OutwardDisposition
  quantity              Int
  linkedSaleId          String?
  linkedTransferId      String?
  returnLocationId      String?
  isReturnProcessed     Boolean             @default(false)
  returnMovementId      String?
  notes                 String?
  createdById           String
  createdAt             DateTime            @default(now())

  outward               InventoryOutward      @relation(fields: [outwardId], references: [id], onDelete: Cascade)
  line                  InventoryOutwardLine? @relation(fields: [lineId], references: [id], onDelete: Cascade)
  product               Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  linkedSale            Sale?                 @relation(fields: [linkedSaleId], references: [id], onDelete: SetNull)
  linkedTransfer        StockTransfer?        @relation(fields: [linkedTransferId], references: [id], onDelete: SetNull)
  returnLocation        Location?             @relation(fields: [returnLocationId], references: [id], onDelete: SetNull)

  @@index([outwardId])
  @@index([lineId])
  @@index([productId])
}

model OutwardApproval {
  id                String   @id @default(uuid())
  outwardId         String
  requesterId       String
  approverId        String
  requestedQty      Int
  reason            String
  status            String   @default("APPROVED")
  beforeDiscrepancy Int
  afterDiscrepancy  Int
  notes             String?
  approvedAt        DateTime @default(now())

  outward           InventoryOutward @relation(fields: [outwardId], references: [id], onDelete: Cascade)
  approver          User             @relation("OutwardApprover", fields: [approverId], references: [id])
  requester         User             @relation("OutwardRequester", fields: [requesterId], references: [id])

  @@index([outwardId])
  @@index([approverId])
}

// -------------------------------------------------------------
// PAYMENTS & CUSTOMER LEDGER
// -------------------------------------------------------------

model Payment {
  id                 String                    @id @default(uuid())
  receiptNumber      String                    @unique
  paymentReference   String?                   @unique
  customerId         String
  amount             Decimal
  unallocatedAmount  Decimal                   @default(0)
  currency           String                    @default("INR")
  paymentMethod      PaymentMethod
  receivedAt         DateTime                  @default(now())
  paymentDate        DateTime                  @default(now())
  referenceNumber    String?
  notes              String?
  status             PaymentStatus             @default(POSTED)
  verificationStatus PaymentVerificationStatus @default(VERIFIED)
  verifiedById       String?
  verifiedAt         DateTime?
  idempotencyKey     String?                   @unique
  createdById        String
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  reversedAt         DateTime?
  reversedById       String?
  reversalReason     String?
  reversedAmount     Decimal                   @default(0)

  customer           Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy          User                      @relation("PaymentCreator", fields: [createdById], references: [id])
  verifiedBy         User?                     @relation("PaymentVerifier", fields: [verifiedById], references: [id])
  reversedBy         User?                     @relation("PaymentReverser", fields: [reversedById], references: [id])
  allocations        PaymentAllocation[]
  advanceMovements   CustomerAdvanceMovement[]

  @@index([receiptNumber])
  @@index([customerId])
  @@index([status])
  @@index([receivedAt])
}

model PaymentAllocation {
  id              String         @id @default(uuid())
  paymentId       String?
  saleId          String
  customerId      String
  allocatedAmount Decimal
  allocationType  AllocationType @default(MANUAL)
  createdById     String
  createdAt       DateTime       @default(now())
  isReversed      Boolean        @default(false)
  reversedAt      DateTime?
  reversedById    String?
  reversalReason  String?

  payment         Payment?       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sale            Sale           @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  advanceMovements CustomerAdvanceMovement[]

  @@index([paymentId])
  @@index([saleId])
  @@index([customerId])
  @@index([createdAt])
}

model CustomerAdvanceMovement {
  id              String              @id @default(uuid())
  customerId      String
  movementType    AdvanceMovementType
  amount          Decimal             // Positive for advance addition, negative for deduction
  balanceAfter    Decimal             // Must never be negative
  paymentId       String?
  allocationId    String?
  saleId          String?
  referenceNumber String?
  notes           String?
  createdById     String
  createdAt       DateTime            @default(now())

  customer        Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payment         Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  allocation      PaymentAllocation?  @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  sale            Sale?               @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([createdAt])
}

model CustomerLedger {
  id              String          @id @default(uuid())
  customerId      String
  entryType       LedgerEntryType
  referenceId     String?
  referenceNumber String
  debit           Decimal         @default(0)
  credit          Decimal         @default(0)
  balance         Decimal
  description     String
  createdById     String
  createdAt       DateTime        @default(now())

  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([createdAt])
}

// -------------------------------------------------------------
// FOLLOW-UPS, DOCUMENTS & COMPANY CONFIGURATION
// -------------------------------------------------------------

model FollowUp {
  id            String         @id @default(uuid())
  customerId    String
  type          FollowUpType   @default(CALL)
  scheduledDate DateTime
  status        FollowUpStatus @default(PENDING)
  outcome       String?
  assignedToId  String
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedTo    User           @relation("FollowUpAssignee", fields: [assignedToId], references: [id])
  createdBy     User           @relation("FollowUpCreator", fields: [createdById], references: [id])

  @@index([customerId])
  @@index([assignedToId])
  @@index([status])
}

model Document {
  id           String   @id @default(uuid())
  entityType   String
  entityId     String
  documentType String
  fileUrl      String
  fileName     String
  fileSize     Int
  uploadedById String
  notes        String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
}

model CompanyConfig {
  id                 String   @id @default("default")
  companyName        String   @default("AEVAN Cleaning")
  brandName          String   @default("GOOD TOUCH")
  gstin              String?
  phone              String   @default("+91-7061101285")
  email              String   @default("info@aevancleaning.com")
  address            String   @default("Bihar Sharif, Nalanda, Bihar")
  logoUrl            String?
  invoicePrefix      String   @default("INV-")
  nextInvoiceNumber  Int      @default(1001)
  orderPrefix        String   @default("ORD-")
  nextOrderNumber    Int      @default(1001)
  salePrefix         String   @default("SAL-")
  nextSaleNumber     Int      @default(1001)
  quotationPrefix    String   @default("QUO-")
  nextQuotationNumber Int     @default(1001)
  outwardPrefix      String   @default("OUT-")
  nextOutwardNumber  Int      @default(1001)
  paymentPrefix      String   @default("PAY-")
  nextPaymentNumber  Int      @default(1001)
  receiptPrefix      String   @default("REC-")
  nextReceiptNumber  Int      @default(1001)
  supplierPrefix     String   @default("SUP-")
  nextSupplierNumber Int      @default(1001)
  poPrefix           String   @default("PO-")
  nextPoNumber       Int      @default(1001)
  grnPrefix          String   @default("GRN-")
  nextGrnNumber      Int      @default(1001)
  billPrefix         String   @default("BIL-")
  nextBillNumber     Int      @default(1001)
  returnPrefix       String   @default("PRT-")
  nextReturnNumber   Int      @default(1001)
  supplierPaymentPrefix String @default("SPAY-")
  nextSupplierPaymentNumber Int @default(1001)
  expensePrefix      String   @default("EXP-")
  nextExpenseNumber  Int      @default(1001)
  currency           String   @default("INR")
  termsAndConditions String?
  deliveryRules      Json?
  updatedAt          DateTime @updatedAt
}

// -------------------------------------------------------------
// PHASE 6: PURCHASES, SUPPLIERS, PAYABLES & EXPENSES
// -------------------------------------------------------------

model Supplier {
  id              String             @id @default(uuid())
  supplierCode    String             @unique
  name            String
  businessName    String?
  contactPerson   String?
  phone           String
  email           String?
  billingAddress  String?
  gstin           String?
  category        String             @default("General")
  paymentTerms    String?            @default("Net 30")
  payableBalance  Decimal            @default(0)
  advanceBalance  Decimal            @default(0)
  isActive        Boolean            @default(true)
  notes           String?
  createdById     String?
  assignedToId    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  createdBy       User?              @relation("SupplierCreator", fields: [createdById], references: [id], onDelete: SetNull)
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  supplierBills   SupplierBill[]
  purchaseReturns PurchaseReturn[]
  supplierPayments SupplierPayment[]
  allocations     SupplierPaymentAllocation[]
  ledgerEntries   SupplierLedger[]
  expenses        Expense[]

  @@index([supplierCode])
  @@index([name])
  @@index([phone])
  @@index([category])
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  poNumber             String              @unique
  supplierId           String
  locationId           String
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  status               PurchaseOrderStatus @default(DRAFT)
  subtotal             Decimal
  discount             Decimal             @default(0)
  tax                  Decimal             @default(0)
  freightCharges       Decimal             @default(0)
  grandTotal           Decimal
  notes                String?
  createdById          String
  submittedAt          DateTime?
  submittedById        String?
  approvedAt           DateTime?
  approvedById         String?
  cancelledAt          DateTime?
  cancelledById        String?
  cancelReason         String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location             Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy            User                @relation("POCreator", fields: [createdById], references: [id])
  approvedBy           User?               @relation("POApprover", fields: [approvedById], references: [id])
  items                PurchaseOrderItem[]
  goodsReceipts        GoodsReceipt[]
  supplierBills        SupplierBill[]

  @@index([poNumber])
  @@index([supplierId])
  @@index([locationId])
  @@index([status])
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  productId        String
  productName      String?
  sku              String?
  unit             String?       @default("pcs")
  orderedQuantity  Int
  receivedQuantity Int           @default(0)
  unitPrice        Decimal
  discount         Decimal       @default(0)
  taxRate          Decimal       @default(18.0)
  lineTotal        Decimal

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([productId])
}

model GoodsReceipt {
  id                    String             @id @default(uuid())
  receiptNumber         String             @unique
  purchaseOrderId       String?
  supplierId            String
  destinationLocationId String
  receivedDate          DateTime           @default(now())
  status                GoodsReceiptStatus @default(POSTED)
  notes                 String?
  createdById           String
  postedAt              DateTime?          @default(now())
  postedById            String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  purchaseOrder         PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplier              Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  destinationLocation   Location           @relation(fields: [destinationLocationId], references: [id], onDelete: Restrict)
  createdBy             User               @relation("GRNCreator", fields: [createdById], references: [id])
  postedBy              User?              @relation("GRNPoster", fields: [postedById], references: [id])
  lines                 GoodsReceiptLine[]
  supplierBills         SupplierBill[]
  purchaseReturns       PurchaseReturn[]

  @@index([receiptNumber])
  @@index([supplierId])
  @@index([destinationLocationId])
  @@index([status])
}

model GoodsReceiptLine {
  id              String       @id @default(uuid())
  goodsReceiptId  String
  productId       String
  productName     String?
  sku             String?
  unit            String?      @default("pcs")
  orderedQty      Int?
  receivedQty     Int
  acceptedQty     Int
  rejectedQty     Int          @default(0)
  rejectionReason String?

  goodsReceipt    GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product         Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([productId])
}

model SupplierBill {
  id                    String                  @id @default(uuid())
  billNumber            String                  @unique
  supplierInvoiceNumber String
  supplierId            String
  purchaseOrderId       String?
  goodsReceiptId        String?
  billDate              DateTime                @default(now())
  dueDate               DateTime?
  subtotal              Decimal
  discount              Decimal                 @default(0)
  tax                   Decimal                 @default(0)
  freight               Decimal                 @default(0)
  grandTotal            Decimal
  paidAmount            Decimal                 @default(0)
  balanceAmount         Decimal
  status                SupplierBillStatus      @default(POSTED)
  notes                 String?
  createdById           String
  postedAt              DateTime?               @default(now())
  postedById            String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  supplier              Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder         PurchaseOrder?          @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceipt          GoodsReceipt?           @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  createdBy             User                    @relation("BillCreator", fields: [createdById], references: [id])
  postedBy              User?                   @relation("BillPoster", fields: [postedById], references: [id])
  items                 SupplierBillItem[]
  allocations           SupplierPaymentAllocation[]
  purchaseReturns       PurchaseReturn[]

  @@unique([supplierId, supplierInvoiceNumber])
  @@index([billNumber])
  @@index([supplierId])
  @@index([status])
}

model SupplierBillItem {
  id             String       @id @default(uuid())
  supplierBillId String
  productId      String?
  productName    String?
  sku            String?
  unit           String?      @default("pcs")
  quantity       Int
  unitPrice      Decimal
  taxRate        Decimal      @default(18.0)
  lineTotal      Decimal

  supplierBill   SupplierBill @relation(fields: [supplierBillId], references: [id], onDelete: Cascade)
  product        Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([supplierBillId])
  @@index([productId])
}

model PurchaseReturn {
  id                   String               @id @default(uuid())
  returnNumber         String               @unique
  supplierId           String
  sourceLocationId     String
  goodsReceiptId       String?
  supplierBillId       String?
  returnDate           DateTime             @default(now())
  reason               String
  status               PurchaseReturnStatus @default(POSTED)
  totalAmount          Decimal              @default(0)
  supplierCreditNoteRef String?
  createdById          String
  postedAt             DateTime?            @default(now())
  postedById           String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  supplier             Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sourceLocation       Location             @relation(fields: [sourceLocationId], references: [id], onDelete: Restrict)
  goodsReceipt         GoodsReceipt?        @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  supplierBill         SupplierBill?        @relation(fields: [supplierBillId], references: [id], onDelete: SetNull)
  createdBy            User                 @relation("ReturnCreator", fields: [createdById], references: [id])
  postedBy             User?                @relation("ReturnPoster", fields: [postedById], references: [id])
  lines                PurchaseReturnLine[]

  @@index([returnNumber])
  @@index([supplierId])
  @@index([sourceLocationId])
  @@index([status])
}

model PurchaseReturnLine {
  id               String         @id @default(uuid())
  purchaseReturnId String
  productId        String
  productName      String?
  sku              String?
  quantity         Int
  unitPrice        Decimal        @default(0)
  lineTotal        Decimal        @default(0)

  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseReturnId])
  @@index([productId])
}

model SupplierPayment {
  id                String                      @id @default(uuid())
  paymentNumber     String                      @unique
  supplierId        String
  amount            Decimal
  unallocatedAmount Decimal                     @default(0)
  paymentMethod     PaymentMethod
  paymentDate       DateTime                    @default(now())
  referenceNumber   String?
  status            SupplierPaymentStatus       @default(POSTED)
  notes             String?
  createdById       String
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  reversedAt        DateTime?
  reversedById      String?
  reversalReason    String?

  supplier          Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy         User                        @relation("SupplierPaymentCreator", fields: [createdById], references: [id])
  reversedBy        User?                       @relation("SupplierPaymentReverser", fields: [reversedById], references: [id])
  allocations       SupplierPaymentAllocation[]

  @@index([paymentNumber])
  @@index([supplierId])
  @@index([status])
}

model SupplierPaymentAllocation {
  id                String          @id @default(uuid())
  supplierPaymentId String?
  supplierBillId    String
  supplierId        String
  allocatedAmount   Decimal
  isReversed        Boolean         @default(false)
  reversedAt        DateTime?
  reversalReason    String?
  createdById       String
  createdAt         DateTime        @default(now())

  supplierPayment   SupplierPayment? @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)
  supplierBill      SupplierBill    @relation(fields: [supplierBillId], references: [id], onDelete: Restrict)
  supplier          Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([supplierPaymentId])
  @@index([supplierBillId])
  @@index([supplierId])
}

model SupplierLedger {
  id              String                  @id @default(uuid())
  supplierId      String
  entryType       SupplierLedgerEntryType
  referenceId     String?
  referenceNumber String
  debit           Decimal                 @default(0)
  credit          Decimal                 @default(0)
  balance         Decimal
  description     String
  createdById     String
  createdAt       DateTime                @default(now())

  supplier        Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([supplierId])
  @@index([createdAt])
}

model ExpenseCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  expenses    Expense[]
}

model Expense {
  id              String          @id @default(uuid())
  expenseNumber   String          @unique
  categoryId      String
  supplierId      String?
  locationId      String?
  title           String
  description     String?
  expenseDate     DateTime        @default(now())
  amount          Decimal
  tax             Decimal         @default(0)
  totalAmount     Decimal
  paymentMethod   PaymentMethod   @default(CASH)
  referenceNumber String?
  status          ExpenseStatus   @default(POSTED)
  createdById     String
  submittedAt     DateTime?
  submittedById   String?
  approvedAt      DateTime?
  approvedById    String?
  rejectedAt      DateTime?
  rejectedById    String?
  rejectionReason String?
  reversalReason  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  category        ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplier        Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  location        Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy       User            @relation("ExpenseCreator", fields: [createdById], references: [id])
  approvedBy      User?           @relation("ExpenseApprover", fields: [approvedById], references: [id])

  @@index([expenseNumber])
  @@index([categoryId])
  @@index([supplierId])
  @@index([status])
  @@index([expenseDate])
}
